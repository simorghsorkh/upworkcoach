# UpworkCoach — environment variables (contract: docs/04-architecture/tech-stack.md section 5)
#
# Local development: copy to `.env` at the repo root (`cp .env.example .env`).
# The values below are for the local embedded Postgres only and are NOT secrets.
# Production values come from the host's secret store (App Service settings, etc.),
# never from a committed file. Empty value = not set.

# --- Database ---------------------------------------------------------------
# Local: started by `pnpm db:start` (embedded Postgres 16, data in .data/pg).
# Production example: postgres://USER:PASSWORD@HOST:5432/upworkcoach?sslmode=require
DATABASE_URL=postgres://upworkcoach:upworkcoach@localhost:5432/upworkcoach

# Integration tests start their own temporary Postgres. To use an existing disposable
# database instead (CI does), export TEST_DATABASE_URL in the shell — it is not read
# from this file. Never point it at real data.

# --- App --------------------------------------------------------------------
# Used to build invite and password-reset links.
APP_BASE_URL=http://localhost:3000
# `__Host-` cookies require Secure; browsers accept that on http://localhost.
SESSION_COOKIE_NAME=__Host-uc_session
# HMAC key for the trusted-device cookie of the login lockout policy (ADR-0003).
# 32 random bytes; REQUIRED in production (the app refuses to start without it).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEVICE_COOKIE_SECRET=
# Trusted reverse proxies in front of the app, used to read the client IP from
# X-Forwarded-For (ADR-0003). Local: 0 (header ignored). Azure App Service: 1.
TRUSTED_PROXY_HOPS=0

# --- File storage -------------------------------------------------------------
# local | supabase | azure-blob | s3   (azure-blob and s3 are stubs for now)
STORAGE_DRIVER=local
# For `supabase`: private bucket, accessed only from the server.
SUPABASE_URL=
# Secret service_role key (NOT the public/publishable key; never NEXT_PUBLIC_*).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
# For `local`: relative paths are resolved from the repo root in development.
LOCAL_STORAGE_DIR=.data/uploads
# For `azure-blob` only:
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
# For `s3` only (MinIO or an S3-compatible Iranian object storage):
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# --- Background jobs (ADR-0007) ---------------------------------------------
# in-process | http-trigger | off
JOBS_MODE=in-process
# Required for http-trigger (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JOB_TRIGGER_SECRET=

# --- Misc -------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# 5 MB
MAX_UPLOAD_BYTES=5242880

# --- docker-compose only (deployment / CI smoke test, not used by `pnpm dev`) ---
# POSTGRES_PASSWORD=
