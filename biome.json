{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "extends": ["./packages/config/biome.base.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/drizzle/meta",
      "!docs",
      "!.claude",
      "!apps/web/src/modules/identity/common-passwords.data.ts"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/*/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/app/(student)/**", "apps/web/src/app/api/v1/me/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/modules/health",
                      "@/modules/health/**",
                      "**/modules/health",
                      "**/modules/health/**"
                    ],
                    "message": "T-STATIC (ADR-0004 section 3): student routes never import the health module (status, reasons, flags)."
                  },
                  {
                    "group": ["@/modules/timeline/repo", "**/modules/timeline/repo"],
                    "importNamePattern": "listSharedNotesForStudent",
                    "invertImportNamePattern": true,
                    "message": "T-STATIC (ADR-0004 section 3): from timeline/repo student routes may only use listSharedNotesForStudent (internal notes stay staff-only)."
                  },
                  {
                    "group": ["@/modules/timeline/service", "**/modules/timeline/service"],
                    "importNamePattern": "listOwnSharedNotes",
                    "invertImportNamePattern": true,
                    "message": "T-STATIC (ADR-0004 section 3): from timeline/service student routes may only use listOwnSharedNotes (staff note and timeline functions are forbidden)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
